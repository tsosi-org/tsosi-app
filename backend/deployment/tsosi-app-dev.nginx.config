# Dev server config (dev.tsosi.org), cf. README.md - Dev server.
# Same as tsosi-app.nginx.config, without the tsosi.org redirects,
# and kept out of search engines.

# Port 80 -
# redirect all traffic to https
server {
  listen 80;
  server_name dev.tsosi.org tsosi-dev.u-ga.fr;
  return 301 https://dev.tsosi.org$request_uri;
}

# Port 443
server {
  server_name dev.tsosi.org;

  include mime.types;
  # fallback in case we can't determine a type
  default_type application/octet-stream;
  access_log /var/log/nginx/access.log combined;
  error_log /var/log/nginx/error.log warn;

  sendfile on;

  listen 443 ssl;
  # Requires nginx 1.25.1+
  http2 on;
  # Installed and renewed by acme.sh (ECDSA key, TLS 1.2/1.3 by default),
  # cf. README.md - Dev server.
  ssl_certificate /etc/ssl/certs/dev.tsosi.org.fullchain.pem;
  ssl_certificate_key /etc/ssl/private/dev.tsosi.org.key;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  # Current uploads are entity logos & icons (2 MB each), with room for
  # future file uploads.
  client_max_body_size 100M;

  keepalive_timeout 5;

  # Not indexed: it is a copy of the production data.
  add_header X-Robots-Tag "noindex, nofollow" always;

  # Enable gzip compression to save file size
  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_min_length 1000;
  gzip_comp_level 6;
  gzip_types text/plain text/css text/xml application/xml application/json application/manifest+json application/javascript text/javascript image/svg+xml;

  # Headers of the requests proxied to Django.
  # We don't want nginx trying to do something clever with redirects,
  # we set the Host header already.
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Host $http_host;
  proxy_redirect off;

  # path for static files
  root /var/www/current/public;

  # Replaces the production robots.txt of the build.
  location = /robots.txt {
    add_header X-Robots-Tag "noindex, nofollow" always;
    default_type text/plain;
    return 200 "User-agent: *\nDisallow: /\n";
  }

  # Frontend app: paths that are not files are handled by the Vue router
  location / {
    try_files $uri /index.html;
  }

  # Always revalidate the app page, so that it never refers to the build
  # files of a previous deploy.
  location = /index.html {
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "no-cache";
  }

  # Build files have a content hash in their name: cache them for a year.
  location /assets/ {
    try_files $uri =404;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location /static/ {
    alias /var/www/current/backend/static/;
  }

  location /media/ {
    alias /tsosi_media/;
  }

  # The API and the Django admin
  location ~ ^/(api|admin)/ {
    proxy_pass http://unix:/run/tsosi_gunicorn.sock;
  }

  # Generated by Django (backend/tsosi/sitemaps.py)
  location = /sitemap.xml {
    proxy_pass http://unix:/run/tsosi_gunicorn.sock;
  }
}
